# Source: RFC sprints-001-oci-a1-primary-hosting, "Architecture choice - Alerts"
# and review CR-002 F2. Instantiated through OnFailure= on the unit that failed.
[Unit]
Description=JetScope failure alert for %i

[Service]
Type=oneshot
ExecStart=/usr/local/bin/oci-tg-alert "jetscope unit failed: %i on %H"
