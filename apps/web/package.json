{
  "name": "@jetscope/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit --ignoreDeprecations 6.0",
    "lint": "npm run typecheck",
    "gate": "npm run build && npm run typecheck && npm run test && npm run lint:design && npm run lint:figure",
    "lint:design": "node ../../scripts/design-system-lint.mjs",
    "lint:figure": "node ../../scripts/figure-contract-lint.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "8.5.25",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
