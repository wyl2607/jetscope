# The web image builds from the repository root, because npm workspaces put the
# lockfile and the hoisted node_modules there. Without this file the build
# context is the entire working tree - node_modules, the SQLite database, the
# Python virtualenv - and the upload alone takes longer than the build.

.git
.github

node_modules
**/node_modules

# Build output. The image builds its own; copying a host build in would ship
# whatever was last compiled on someone's laptop.
.next
**/.next
apps/web/dist
**/*.tsbuildinfo

# Python side. The API image builds from the repository root
# (`docker build -f apps/api/Dockerfile .`).
apps/api/.venv
**/__pycache__
**/*.pyc

# Runtime state. The SQLite database is a host bind mount
# (${JETSCOPE_HOST_DATA_DIR:-/opt/jetscope/data} -> /app/data) and must not be
# baked into an image. Curated event JSON is product content: curated_events.py
# reads it from the API image. Excluding the parent directory `data` would make
# the exception below unreachable, so ignore the contents and re-include only
# data/curated.
data/**
!data/curated
!data/curated/**
*.db
*.sqlite
*.sqlite3

# Local secrets and operator state, in case one is sitting in the tree.
.env
.env.*
!.env.example
.deploy-commit

# Editor and OS noise
.DS_Store
._*
.vscode
.idea
